# URL of the Django backend (server-side only; the browser uses same-origin /api via rewrites)
BACKEND_URL=http://127.0.0.1:8000
# Public site URL, used for SEO metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Production address (canonical URLs, sitemap, Open Graph), e.g. https://medmapp.uz
# NEXT_PUBLIC_SITE_URL is above. Search engine ownership tokens (optional):
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# Same value as INTERNAL_API_TOKEN in backend/.env (lifts the API rate limit for server-side rendering)
INTERNAL_API_TOKEN=
