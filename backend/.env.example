# ---- Core ----
DEBUG=False
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=medmapp.uz,www.medmapp.uz,api.medmapp.uz,localhost
CORS_ALLOWED_ORIGINS=https://medmapp.uz,https://www.medmapp.uz
CSRF_TRUSTED_ORIGINS=https://medmapp.uz,https://www.medmapp.uz
FRONTEND_URL=https://medmapp.uz
SECURE_SSL_REDIRECT=True

# ---- Database (PostgreSQL). For local dev without Postgres: DB_ENGINE=sqlite ----
DB_ENGINE=postgres
DB_NAME=medmapp
DB_USER=medmapp
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ---- Storage (private medical files are never served by URL) ----
MEDIA_ROOT=/data/media
PRIVATE_MEDIA_ROOT=/data/private_media
MAX_UPLOAD_MB=25
SIGNED_URL_TTL_SECONDS=600

# ---- JWT ----
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7

# ---- Rate limits ----
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min
THROTTLE_FORM=10/min
THROTTLE_ASSISTANT=20/min

# ---- Email (console backend prints emails to logs until configured) ----
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=MedMapp <no-reply@medmapp.uz>

# ---- Integrations (optional; status shown in /admin/integrations) ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
GOOGLE_MAPS_API_KEY=
# Any USD-based JSON rates API returning {"base":"USD","rates":{...}} or {"base_code":"USD","conversion_rates":{...}}
CURRENCY_API_URL=
CURRENCY_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
PAYMENT_PROVIDER=

LOG_LEVEL=INFO

# Proxies in front of Django (Nginx in production, Next.js rewrite locally). Used to read the real client IP for rate limits.
NUM_PROXIES=1

# Patient sign-in with Google: OAuth client ID ("Web application"; authorised JavaScript origin = your site URL)
GOOGLE_CLIENT_ID=
# Patient sign-in with an SMS code. SMS_PROVIDER=console only writes the code to the server log (development).
SMS_LOGIN_ENABLED=true
SMS_PROVIDER=console
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
THROTTLE_SMS=10/hour
# Prefix of request numbers (MM-0001)
REFERENCE_PREFIX=MM

# Shared cache (rate limits, public API cache). docker-compose sets redis://redis:6379/0. Empty = in-memory cache.
REDIS_URL=
PUBLIC_CACHE_SECONDS=120
GUNICORN_WORKERS=3

# Shared secret: the Next.js server sends it (X-Internal-Token) so server-side rendering is not rate-limited.
# Use the same random value in web/.env.local (or the web service environment). Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
INTERNAL_API_TOKEN=
